# None of these are required to run Taskar. Jira is normally configured from
# the app's UI (Jira Import → Connection settings), which stores credentials
# server-side in an encrypted cookie — not here.

# Recommended for production: a long random string used to encrypt the Jira
# API token before it's stored in a cookie. Without this, a fallback key is
# used instead of a real secret. This is a one-time, deploy-level setting —
# not something you touch when reconfiguring Jira day to day.
APP_SECRET=

# Optional fallback: if set, these are used whenever nothing has been saved
# via the Jira Import UI yet. Saving settings in the UI always takes
# priority over these. Useful for a shared/team deployment where you'd
# rather manage the connection at deploy time.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT=

# Email (Resend, provisioned via the Vercel Marketplace).
# RESEND_API_KEY is set automatically by `vercel integration add resend/resend-email`.
# EMAIL_FROM must use a domain verified in Resend, otherwise sending is
# rejected for every recipient except your own address.
RESEND_API_KEY=
EMAIL_FROM="Taskar <invites@example.com>"

# Clerk webhooks. Needed for the branded team-invitation email: add an endpoint
# pointing at /api/webhooks/clerk in the Clerk Dashboard (subscribe to
# organizationInvitation.created) and paste its signing secret here.
CLERK_WEBHOOK_SIGNING_SECRET=
